<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="64dp"
    android:height="64dp"
    android:viewportWidth="64"
    android:viewportHeight="64">
    <!-- Outer Shield Halo Glow -->
    <path
        android:pathData="M32,4 L10,16 L10,34 C10,48 20,58 32,62 C44,58 54,48 54,34 L54,16 Z"
        android:strokeWidth="1.5"
        android:strokeAlpha="0.6">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="10"
                android:startY="4"
                android:endX="54"
                android:endY="62"
                android:type="linear">
                <item android:offset="0.0" android:color="#00E5FF" />
                <item android:offset="0.5" android:color="#3B82F6" />
                <item android:offset="1.0" android:color="#0284C7" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Left High-Tech Wing Chevron -->
    <path
        android:pathData="M32,10 L14,20 L16,42 C20,50 26,55 32,58 L32,36 L24,31 L32,10 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="14"
                android:startY="10"
                android:endX="32"
                android:endY="58"
                android:type="linear">
                <item android:offset="0.0" android:color="#00E5FF" />
                <item android:offset="0.7" android:color="#0284C7" />
                <item android:offset="1.0" android:color="#0369A1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Right High-Tech Wing Chevron -->
    <path
        android:pathData="M32,10 L50,20 L48,42 C44,50 38,55 32,58 L32,36 L40,31 L32,10 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="50"
                android:startY="10"
                android:endX="32"
                android:endY="58"
                android:type="linear">
                <item android:offset="0.0" android:color="#38BDF8" />
                <item android:offset="0.7" android:color="#2563EB" />
                <item android:offset="1.0" android:color="#1D4ED8" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Center Core Emblem Core Diamond -->
    <path
        android:pathData="M32,18 L38,30 L32,44 L26,30 Z"
        android:fillColor="#00E5FF" />

    <!-- Center Quantum Core Heart -->
    <path
        android:pathData="M32,24 L35,30 L32,36 L29,30 Z"
        android:fillColor="#FFFFFF" />
</vector>
