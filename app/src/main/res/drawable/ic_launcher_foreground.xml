<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Subtle, elegant solar eclipse corona aura (representing 'The Sun Production') in dark electric blue -->
    <path
        android:pathData="M54,26 A28,28 0 1,1 53.99,26 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="54"
                android:startY="54"
                android:endX="82"
                android:endY="54"
                android:type="radial"
                android:gradientRadius="30">
                <item android:color="#550052D4" android:offset="0.0" />
                <item android:color="#3300E5FF" android:offset="0.4" />
                <item android:color="#1A1D4ED8" android:offset="0.75" />
                <item android:color="#00050B14" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Solar Eclipse Thin Glowing Rim -->
    <path
        android:pathData="M54,29 A25,25 0 1,1 53.99,29 Z"
        android:strokeWidth="1.2"
        android:strokeColor="#6600E5FF"
        android:fillColor="#00000000" />

    <!-- Outer Neon Cyan Geometric Shield Framing -->
    <path
        android:pathData="M54,23 L75,32 L75,54 C75,67 66,77 54,82 C42,77 33,67 33,54 L33,32 Z"
        android:strokeWidth="2.2"
        android:strokeColor="#00E5FF"
        android:fillColor="#1500E5FF" />

    <!-- Glassmorphic Inner Shield Base with Deep Navy / Cyan Gradient -->
    <path
        android:pathData="M54,27 L71,34.5 L71,53 C71,63.5 63.5,72 54,76.5 C44.5,72 37,63.5 37,53 L37,34.5 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="37"
                android:startY="27"
                android:endX="71"
                android:endY="76"
                android:type="linear">
                <item android:color="#E607182B" android:offset="0.0" />
                <item android:color="#CC0A2342" android:offset="0.6" />
                <item android:color="#F0030C19" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Sleek Geometric Letter "A" Apex & Wings -->
    <!-- Left Stela of A -->
    <path
        android:pathData="M54,34 L43,62 L48,62 L54,45 L60,62 L65,62 Z"
        android:fillColor="#00E5FF" />

    <!-- Horizontal Cyber Crossbar of A -->
    <path
        android:pathData="M46.5,53 L61.5,53 L61.5,56 L46.5,56 Z"
        android:fillColor="#FFFFFF" />

    <!-- Central Diamond Node in "A" Apex -->
    <path
        android:pathData="M54,42 L56.5,46 L54,50 L51.5,46 Z"
        android:fillColor="#050B14" />

    <!-- Glassmorphic Top Edge Shimmer Line -->
    <path
        android:pathData="M54,28 L69,35"
        android:strokeWidth="1.2"
        android:strokeColor="#AAFFFFFF" />
</vector>
