<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Glowing Red Danger Corona Aura -->
    <path
        android:pathData="M54,26 A28,28 0 1,1 53.99,26 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="54"
                android:startY="54"
                android:endX="82"
                android:endY="54"
                android:type="radial"
                android:gradientRadius="30">
                <item android:color="#77FF1744" android:offset="0.0" />
                <item android:color="#44D50000" android:offset="0.4" />
                <item android:color="#22B71C1C" android:offset="0.75" />
                <item android:color="#00000000" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Outer Crimson Alert Geometric Shield Framing -->
    <path
        android:pathData="M54,23 L75,32 L75,54 C75,67 66,77 54,82 C42,77 33,67 33,54 L33,32 Z"
        android:strokeWidth="2.2"
        android:strokeColor="#FF1744"
        android:fillColor="#1FFF1744" />

    <!-- Inner Warning Triangle Matrix -->
    <path
        android:pathData="M54,34 L70,62 L38,62 Z"
        android:strokeWidth="1.8"
        android:strokeColor="#FF5252"
        android:fillColor="#22FF1744" />

    <!-- Warning Exclamation Mark (Alert Active) -->
    <path
        android:pathData="M54,42 L54,53"
        android:strokeWidth="3.0"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round" />

    <path
        android:pathData="M54,58 A1.5,1.5 0 1,1 53.99,58 Z"
        android:fillColor="#FFFFFF" />

    <!-- Bottom Pulse Ping -->
    <path
        android:pathData="M46,72 L54,78 L62,72"
        android:strokeWidth="1.5"
        android:strokeColor="#FF1744"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
