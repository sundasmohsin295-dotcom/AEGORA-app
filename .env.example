# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# REVENUECAT_PUBLIC_API_KEY: Public SDK key for RevenueCat in-app subscriptions.
REVENUECAT_PUBLIC_API_KEY=goog_YOUR_PUBLIC_API_KEY_HERE

# Production Backend & Microservice Configuration Keys
STRIPE_SECRET_KEY=sk_test_placeholder_stripe_key
REVENUECAT_SECRET_KEY=rc_test_placeholder_revenuecat_key
ONESIGNAL_APP_ID=aegora-onesignal-app-id-placeholder
ONESIGNAL_REST_API_KEY=os_key_placeholder_onesignal
AGENT_WEBHOOK_SECRET=aegora_hmac_secret_placeholder
JWT_SECRET_KEY=aegora_hs512_master_secret_rotatable_enclave_key
SUPABASE_URL=https://your-supabase-instance.supabase.co
SUPABASE_KEY=your-supabase-anon-key

